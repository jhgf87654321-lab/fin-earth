{
  "include": [
      "src/ts/**/*",
      "shared/**/*.json"
  ],
  "compilerOptions": {
      "module": "ESNext",
      "target": "ESNext",
      "moduleResolution": "node",
      "declaration": true,
      "declarationDir": "build/types",
      "baseUrl": ".",
      "noImplicitAny": false,
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true
  }
}